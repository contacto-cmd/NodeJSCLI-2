# THRONE PROTOCOL v3.0 — ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# RFC & Identity
RFC=RIGR840827PJ0
OWNER_NAME=Roberto Rivera Gamas
DOMAIN=streetemporioroyal.com

# Cryptography (PASTE YOUR RSA-4096 PRIVATE KEY HERE)
RSA_PRIVATE_PEM="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC5xQPz...
[CONTINUE WITH YOUR KEY]
-----END PRIVATE KEY-----"

# AI Integration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Twilio (SMS Gateway)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Backend Services
SINI_BACKEND_URL=http://localhost:3001
SINI_TOKEN_SECRET=your-sini-secret-key

# Orchestrator
ORCHESTRATOR_URL=http://localhost:4000
ORCHESTRATOR_API_KEY=your-orchestrator-key

# Webhooks & Notifications
ROYAL_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Database (Future: D1)
DATABASE_URL=your-database-url
DATABASE_SECRET=your-database-secret

# Server
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/throne.log

# Session
SESSION_SAVE_PATH=./data/sessions
AUDIT_LOG_PATH=./data/audit.log

# Feature Flags
ENABLE_AI_INTEGRATION=true
ENABLE_BLOCKCHAIN_LOGGING=false
ENABLE_MULTI_USER=false
